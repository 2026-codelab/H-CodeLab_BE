# 1단계: 빌드
FROM eclipse-temurin:11-jdk-jammy AS builder
WORKDIR /app

# 의존성부터 받아서 캐시 (소스만 바뀌면 이 단계는 재사용)
COPY gradlew gradlew.bat ./
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./
RUN chmod +x gradlew && ./gradlew dependencies --no-daemon

COPY src/ src/
RUN ./gradlew build --no-daemon -x test

# 2단계: 실행
FROM eclipse-temurin:11-jre-jammy AS runtime
WORKDIR /opt/app

COPY --from=builder /app/build/libs/ ./libs/
RUN cp /opt/app/libs/*-SNAPSHOT.war /opt/app/app.jar && rm -rf /opt/app/libs/

# root가 아닌 사용자로 실행 + 로그 폴더 권한
RUN groupadd -r appuser && useradd -r -g appuser appuser \
    && mkdir -p /var/log/handongjudge \
    && chown -R appuser:appuser /opt/app /var/log/handongjudge
USER appuser

ENV TZ=Asia/Seoul
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=90s --retries=5 \
    CMD curl -fs http://localhost:8080/actuator/health || exit 1

CMD ["java", "-Djava.security.egd=file:/dev/./urandom", "-Dspring.profiles.active=deploy", "-jar", "/opt/app/app.jar"]